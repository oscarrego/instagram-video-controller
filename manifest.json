{
  "manifest_version": 3,
  "name": "Instagram Reel Player Pro",
  "version": "1.0.0",
  "description": "Enhances Instagram Reels with YouTube-style video controls, keyboard shortcuts, speed selector, seeking, and Picture-in-Picture.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Instagram Reel Player Pro Controls"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "player.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
